#!/usr/bin/env python3
"""pre-commit hook: 阻止提交含敏感信息(密码/token/密钥)的代码。

只扫描暂存区(staged diff)中新增/修改的内容行(带 + 前缀),
自动跳过 docs/、记录.md 与 .env 等已忽略文件。
"""
import re
import subprocess
import sys

# 敏感信息正则(单行,覆盖常见形式)
#   - password/secret/token/api_key/app_secret/access_key 等赋值(带引号或裸值)
#   - URL 内嵌凭据 user:pass@host
#   - 私钥内容
PATTERNS = [
    re.compile(
        r"(?:password|passwd|secret|token|api[_-]?key|app[_-]?secret"
        r"|access[_-]?key|client[_-]?secret|private[_-]?key)"
        r"\s*[\"']?\s*[=:]\s*[\"'][^\"']{8,}[\"']",
        re.IGNORECASE,
    ),
    re.compile(
        r"(?:[\w.-]*[\s_=-]*)(?:PASSWORD|PASSWD|SECRET|TOKEN|API[_-]?KEY"
        r"|APP[_-]?SECRET|ACCESS[_-]?KEY|CLIENT[_-]?SECRET|PRIVATE[_-]?KEY)"
        r"\s*=\s*[A-Za-z0-9_\-./+]{12,}\s*$"
    ),
    re.compile(r"https?://[^/\s\"']+:[^@\s\"']+@"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
]

# 测试/示例中允许出现的假值与占位符
ALLOWED = re.compile(
    r"sk-test|[\"']secret123[\"']|your_[a-z_]+_here|<your_[a-z_]+>|password=\s*[\"']x[\"']"
)


def staged_added_lines() -> list[str]:
    """返回暂存区 diff 中新增内容行(带 + 前缀),跳过 docs 与记录.md。"""
    try:
        out = subprocess.run(
            [
                "git", "diff", "--cached", "--unified=0", "--",
                ".", ":(exclude)docs", ":(exclude)记录.md",
            ],
            capture_output=True, text=True, check=True,
        ).stdout
    except subprocess.CalledProcessError:
        return []
    return [ln[1:] for ln in out.splitlines() if ln.startswith("+") and not ln.startswith("+++")]


def main() -> int:
    hits = []
    for line in staged_added_lines():
        if ALLOWED.search(line):
            continue
        for pat in PATTERNS:
            if pat.search(line):
                hits.append(line)
                break

    if hits:
        print("ERROR: 检测到暂存内容可能包含敏感信息,已阻止提交:", file=sys.stderr)
        for h in hits:
            print(f"  {h}", file=sys.stderr)
        print("", file=sys.stderr)
        print("请将敏感信息改为从环境变量/.env 读取,移除后重新 git add 再提交。", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
