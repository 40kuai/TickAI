# ======================================
# 🎫 TickAI Configuration Template
# ======================================
# Copy this file to .env and fill in your real values
# ======================================

# ======================================
# 🤖 TokenHub (LLM) - Required
# ======================================
TOKENHUB_API_KEY=your_tokenhub_api_key_here
TOKENHUB_MODEL=deepseek-v4-flash
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3

# ======================================
# 💾 Database Configuration - Required
# ======================================
OPS_DB_PATH=data/opsticket.db

# ======================================
# 🔐 Admin Credentials - Required on First Run
# ======================================
# If not set, a secure random password will be generated and printed to console
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here

# ======================================
# 🔑 JWT Secret - Recommended
# ======================================
# Stable secret for JWT signing. If not set, sessions reset on each restart.
JWT_SECRET=your_jwt_secret_here

# ======================================
# 🌐 CORS Origins - Optional
# ======================================
# Comma-separated list of allowed origins. Defaults to localhost:5173.
CORS_ORIGINS=http://localhost:5173

# ======================================
# 🍪 Cookie Secure - 生产环境建议开启
# ======================================
# 设为 true 后会话 Cookie 带 Secure 标志(仅 HTTPS 传输)。
# 本地 HTTP 开发保持 false;生产(HTTPS)必须设为 true。
# COOKIE_SECURE=true

# ======================================
# 🔐 LDAP Configuration - Optional
# ======================================
# LDAP_SERVER=ldap.example.com
# LDAP_PORT=636
# LDAP_USE_SSL=true
# LDAP_BIND_DN=CN=ldap_search_user,OU=Service Accounts,DC=example,DC=com
# LDAP_BIND_PASSWORD=your_ldap_password_here
# LDAP_SEARCH_BASE=OU=Users,DC=example,DC=com

# ======================================
# 🔄 Host Sync - 通过 Web UI 配置
# ======================================
# 主机同步配置已迁移到数据库，请在「服务器管理」页面的
# 「同步配置」弹窗中设置 API 地址、认证方式和字段映射

# ======================================
# 🔧 Advanced - Optional
# ======================================
# DEBUG=false

# ======================================
# 💬 Feishu Bot - Optional
# ======================================
# 企业自建应用凭据(开放平台「凭证与基础信息」页)
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# 允许使用机器人的用户 OpenID(逗号分隔)。留空则无人可用。
# FEISHU_OPENID_WHITELIST=ou_xxx,ou_yyy

# ======================================
# 📦 Nightingale (N9E) 告警查询 - Optional
# ======================================
# 告警平台 API 地址与个人中心 Token(请求头 X-User-Token)
# NIGHTINGALE_URL=https://alert.example.com
# NIGHTINGALE_TOKEN=your_nightingale_token_here

# ======================================
# 🩺 自愈闭环 (KR2) - Optional
# ======================================
# 命令模板白名单(逗号分隔,默认空=禁用写动作,安全兜底)。
# 只有白名单内的值才会被渲染为可执行的写命令,LLM 无法构造任意命令。
# 服务名白名单(process_restart 的 systemctl restart 目标)
# SELFHEAL_SERVICE_WHITELIST=nginx,redis
# 日志/文件路径白名单(disk_clean 的 truncate 目标)
# SELFHEAL_LOG_PATH_WHITELIST=/var/log/nginx/access.log,/var/log/app/app.log
# drop_caches 模式白名单(1=页缓存 2=目录项/索引节点 3=全部;建议仅放行 3)
# SELFHEAL_DROPCACHES_MODES_WHITELIST=3
# 业务高峰期(进程重启在此区间强制高危审批),形如 9-12,14-18;默认 9-18
# SELFHEAL_PEAK_HOURS=9-18
